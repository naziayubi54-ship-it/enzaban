{
  "name": "lingoplus",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "apk:open": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/app": "^7.0.2",
    "@capacitor/core": "^7.4.0",
    "@capacitor/status-bar": "^7.0.2",
    "@fontsource/vazirmatn": "^5.2.5",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "canvas-confetti": "^1.9.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3"
  }
}
